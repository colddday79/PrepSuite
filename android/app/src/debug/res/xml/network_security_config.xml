<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the app reach a coach server over plain http, on this computer
     (10.0.2.2 from the emulator) or on a Mac on the same Wi-Fi (flutter run with
     COACH_URL=http://<mac-ip>:8787/coach). Release builds keep the default config, which
     blocks cleartext traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
