# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Large model files: recreate with tools/voice/fetch_models.sh. The folders
# stay in git (README.md and .gitkeep files) so the asset directories declared
# in pubspec.yaml exist in fresh clones and CI; the app then runs without voice.
/assets/models/**
!/assets/models/**/
!/assets/models/README.md
!/assets/models/**/.gitkeep
*.onnx
